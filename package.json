{
  "name": "dsh-workspace-tidy",
  "version": "0.1.1",
  "description": "Keep a DSH workspace tidy: move generated scripts, temp files and render leftovers into a hidden .dsh folder.",
  "license": "MIT",
  "author": "dengwei84",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dengwei84/dsh-workspace-tidy.git"
  },
  "homepage": "https://github.com/dengwei84/dsh-workspace-tidy",
  "bugs": {
    "url": "https://github.com/dengwei84/dsh-workspace-tidy/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workspace",
    "tidy",
    "cleanup"
  ],
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/tidy.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
